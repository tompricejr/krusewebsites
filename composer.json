{
  "require": {
    "aelvan/mailchimp-subscribe": "3.0.2",
    "carlcs/craft-redactorcustomstyles": "3.0.4",
    "craftcms/cms": "3.9.15",
    "craftcms/feed-me": "4.8.0",
    "craftcms/redactor": "2.10.12",
    "elleracompany/craft-cookie-consent": "^1.6",
    "nystudio107/craft-seomatic": "3.4.70",
    "sebastianlenz/linkfield": "1.0.25",
    "spicyweb/craft-embedded-assets": "2.11.4",
    "verbb/expanded-singles": "1.2.0",
    "verbb/super-table": "2.7.5.1",
    "vlucas/phpdotenv": "^3.4.0"
  },
  "require-dev": {
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.0"
    },
    "allow-plugins": {
      "kylekatarnls/update-helper": true,
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ]
}
